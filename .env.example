# Banco Neon. Configure somente no servidor/Vercel; nunca use prefixo VITE_.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Chave usada para assinar o cookie de sessão. Use uma string aleatória longa (32+ caracteres).
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Opção simples: um único usuário.
APP_LOGIN_EMAIL=usuario@empresa.com
APP_LOGIN_PASSWORD=troque-esta-senha

# Opção para vários usuários. Se preenchida, é combinada com o usuário acima.
# APP_USERS_JSON=[{"email":"usuario1@empresa.com","password":"senha1"},{"email":"usuario2@empresa.com","password":"senha2"}]
